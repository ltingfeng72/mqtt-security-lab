[req]
default_bits = 2048
prompt = no
default_md = sha256
distinguished_name = distinguished_name
req_extensions = server_certificate

[distinguished_name]
commonName = mqtt-local-broker

[server_certificate]
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
subjectAltName = @alt_names

# Address verification relies on this SAN, not on the Common Name.
[alt_names]
IP.1 = 127.0.0.1
